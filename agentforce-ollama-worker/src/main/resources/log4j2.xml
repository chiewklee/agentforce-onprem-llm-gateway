<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Appenders>
        <!-- Per-app rolling log file: <runtime>/logs/agentforce-ollama-worker.log -->
        <RollingFile name="file"
            fileName="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}agentforce-ollama-worker.log"
            filePattern="${sys:mule.home}${sys:file.separator}logs${sys:file.separator}agentforce-ollama-worker-%i.log">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
            <SizeBasedTriggeringPolicy size="10 MB"/>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>
        <!-- Also echo to the daemon console (captured in mule_ee.log) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%-5p %d [%t] [processor: %X{processorPath}; event: %X{correlationId}] %c: %m%n"/>
        </Console>
    </Appenders>

    <Loggers>
        <!-- flow <logger> components (REQUEST / RESPONSE lines) -->
        <AsyncLogger name="org.mule.runtime.core.internal.processor.LoggerMessageProcessor" level="DEBUG"/>
        <!-- Raw HTTP wire traffic (Ollama calls). Logs headers incl. Authorization — local debugging only -->
        <AsyncLogger name="org.mule.service.http.impl.service.HttpMessageLogger" level="INFO"/>

        <AsyncRoot level="INFO">
            <AppenderRef ref="file"/>
            <AppenderRef ref="Console"/>
        </AsyncRoot>
    </Loggers>
</Configuration>
